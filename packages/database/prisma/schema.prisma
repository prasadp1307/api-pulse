generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  monitors        Monitor[]
  apiKeys         ApiKey[]
  apiCollections  ApiCollection[]
  savedRequests   SavedApiRequest[]
  apiEnvironments ApiEnvironment[]
  apiTestHistory  ApiTestHistory[]
  apiWorkflows    ApiWorkflow[]
  openApiDocuments OpenApiDocument[]
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  keyHash   String   @unique
  prefix    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  lastUsed  DateTime?
}

model Monitor {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  url             String
  method          HttpMethod    @default(GET)
  intervalSec     Int           @default(60)
  timeoutMs       Int           @default(30000)
  expectedStatus  Int           @default(200)
  headers         Json          @default("{}")
  body            String?
  enabled         Boolean       @default(true)
  lastCheckedAt   DateTime?
  nextCheckAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  checks          HealthCheck[]
  alertRules      AlertRule[]

  @@index([enabled, nextCheckAt])
  @@index([userId])
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
}

model HealthCheck {
  id           String      @id @default(cuid())
  monitorId    String
  monitor      Monitor     @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status       CheckStatus
  httpStatus   Int?
  latencyMs    Int
  errorMessage String?
  responseBody String?     @db.Text
  checkedAt    DateTime    @default(now())

  @@index([monitorId, checkedAt(sort: Desc)])
}

enum CheckStatus {
  UP
  DOWN
  DEGRADED
}

model AlertRule {
  id              String    @id @default(cuid())
  monitorId       String
  monitor         Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean   @default(true)
  consecutiveDown Int       @default(1)
  latencyThresholdMs Int?
  createdAt       DateTime  @default(now())
  events          AlertEvent[]
}

model AlertEvent {
  id          String    @id @default(cuid())
  alertRuleId String
  alertRule   AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  message     String
  severity    AlertSeverity @default(WARNING)
  acknowledged Boolean  @default(false)
  createdAt   DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model ApiCollection {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  requests    SavedApiRequest[]

  @@index([userId])
}

model SavedApiRequest {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionId     String?
  collection       ApiCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  name             String
  method           HttpMethod     @default(GET)
  url              String
  headers          Json           @default("[]")
  queryParams      Json           @default("[]")
  body             String?        @db.Text
  bodyType         String         @default("json")
  authType         String         @default("none")
  authConfig       Json           @default("{}")
  preRequestScript String?        @db.Text
  testScript       String?        @db.Text
  chainExtract     Json?
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([collectionId])
}

model ApiEnvironment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  variables Json     @default("{}")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ApiWorkflow {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  steps       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model OpenApiDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  spec      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ApiTestHistory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestName     String?
  method          String
  url             String
  statusCode      Int?
  latencyMs       Int
  requestSnapshot Json
  responseHeaders Json?
  responseBody    String?  @db.Text
  testResults     Json?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model RequestLog {
  id         String   @id @default(cuid())
  source     String
  method     String
  path       String
  statusCode Int
  latencyMs  Int
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([source])
}
