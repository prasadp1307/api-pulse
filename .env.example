# Database
# Port 5434 avoids conflict with local Postgres (5432) and other services (5433)
DATABASE_URL="postgresql://apipulse:apipulse@localhost:5434/apipulse?schema=public"

# Redis
# Port 6380 avoids conflict with a local Redis on 6379
REDIS_URL="redis://localhost:6380"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string-in-production"

# Demo login (seed user)
SEED_USER_EMAIL="admin@apipulse.local"
SEED_USER_PASSWORD="admin123"

# Worker
WORKER_POLL_INTERVAL_MS=5000
CHECK_TIMEOUT_MS=30000

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_REQUESTS=100

# Alert webhook (optional)
ALERT_WEBHOOK_URL=""

# Allow http://localhost and private IPs in API Workspace proxy (dev only)
WORKSPACE_ALLOW_PRIVATE_URLS="true"
